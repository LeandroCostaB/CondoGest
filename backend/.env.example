POSTGRES_USER=condogest
POSTGRES_PASSWORD=condogest

RABBITMQ_USER=guest
RABBITMQ_PASS=guest

JWT_SECRET=troque-em-producao

# Popula o banco com dados iniciais ao subir os serviços.
# Use "true" apenas em desenvolvimento. Ignorado se o banco já tiver dados.
SEED_DB=false

# notification-service — obrigatório para envio de e-mail
# Crie uma "Senha de app" em: https://myaccount.google.com/apppasswords
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=senha-de-app-do-gmail

# notification-service — opcional, apenas se usar notificações push
FIREBASE_CREDENTIALS_PATH=
