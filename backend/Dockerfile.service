ARG SERVICE_NAME

# ── Build stage ───────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}

WORKDIR /app

# Copia toda a estrutura do monorepo para preservar os caminhos relativos
# que o tsconfig (rootDir=../../) e o tsc-alias esperam
COPY . .

# Instala dependências do serviço
RUN npm install --prefix services/${SERVICE_NAME}

# Cria symlink: /app/node_modules → node_modules do serviço
# Isso permite que o TypeScript resolva pacotes a partir dos arquivos shared/src/
# (que não possuem node_modules próprio), subindo a árvore de diretórios
RUN ln -s /app/services/${SERVICE_NAME}/node_modules /app/node_modules

# Compila o serviço (nest build) e reescreve os path aliases (tsc-alias)
RUN npm run build --prefix services/${SERVICE_NAME}

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}
ENV NODE_ENV=production

WORKDIR /app/services/${SERVICE_NAME}

# Instala apenas dependências de produção
COPY services/${SERVICE_NAME}/package*.json ./
RUN npm ci --omit=dev

# Copia o dist compilado (inclui shared/src compilado em dist/shared/src/)
COPY --from=builder /app/services/${SERVICE_NAME}/dist ./dist

EXPOSE 3000

CMD ["npm", "run", "start:prod"]
