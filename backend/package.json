{
  "name": "condogest-monorepo",
  "private": true,
  "scripts": {
    "typecheck:core": "npm run typecheck --prefix services/core-service",
    "typecheck:ticket": "npm run typecheck --prefix services/ticket-service",
    "typecheck:notification": "npm run typecheck --prefix services/notification-service",
    "typecheck:all": "npm run typecheck:core && npm run typecheck:ticket && npm run typecheck:notification",
    "check:core": "npm run check --prefix services/core-service",
    "check:ticket": "npm run check --prefix services/ticket-service",
    "check:notification": "npm run check --prefix services/notification-service",
    "check:all": "npm run check:core && npm run check:ticket && npm run check:notification",
    "start:core": "npm run start:dev --prefix services/core-service",
    "start:ticket": "npm run start:dev --prefix services/ticket-service",
    "start:notification": "npm run start:dev --prefix services/notification-service"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "~4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "~11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "~11.2.6",
    "amqplib": "~1.0.3",
    "bcryptjs": "~3.0.3",
    "class-transformer": "~0.5.1",
    "class-validator": "~0.15.1",
    "drizzle-orm": "~0.45.1",
    "pg": "~8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.4.6",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "~0.10.8",
    "@types/bcryptjs": "~2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "~8.18.0",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "~0.31.9",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
